<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>br.com.marketplace</groupId>
  <artifactId>mini-marketplace</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Mini Marketplace</name>

  <modules>
    <module>libs/event-contracts</module>
    <module>libs/messaging-support</module>
    <module>libs/architecture-rules</module>
    <module>lambdas/nfe-emitter-lambda</module>
    <module>services/ingestion-service</module>
    <module>services/catalog-service</module>
    <module>services/inventory-service</module>
    <module>services/order-service</module>
    <module>services/payment-service</module>
    <module>services/invoice-service</module>
    <module>services/shipping-service</module>
    <module>services/notification-service</module>
    <module>services/audit-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.1</archunit.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <enforcer.version>3.5.0</enforcer.version>
    <aws.sdk.version>2.30.38</aws.sdk.version>
    <aws.lambda.core.version>1.2.3</aws.lambda.core.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>br.com.marketplace</groupId>
        <artifactId>event-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.marketplace</groupId>
        <artifactId>messaging-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.marketplace</groupId>
        <artifactId>architecture-rules</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.marketplace</groupId>
        <artifactId>nfe-emitter-lambda</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amazonaws</groupId>
        <artifactId>aws-lambda-java-core</artifactId>
        <version>${aws.lambda.core.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-circuitbreaker</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- TRAVAS DE BUILD (ADR-0009): o build quebra se alguem violar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>architecture-locks</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <!-- Servico nunca depende de outro servico: so conversam por mensagens -->
                    <exclude>br.com.marketplace:*-service</exclude>
                    <exclude>commons-logging:commons-logging</exclude>
                  </excludes>
                  <message>Servicos nao podem depender uns dos outros (ADR-0001). Compartilhe apenas contratos.</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
